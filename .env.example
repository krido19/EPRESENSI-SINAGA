# ─── ePresensi Jateng Environment Variables ─────────────────────────
# Salin file ini menjadi .env dan sesuaikan nilainya.

# Port Server
PORT=3000

# Secret Key untuk Enkripsi Token Sesi Dashboard (Gunakan string acak panjang di production)
APP_SECRET=

# Password Akses Dashboard Aplikasi (Default: SMK3magelang)
APP_PASSWORD=SMK3magelang

# Akun ePresensi Jateng (Opsional: Dapat juga diisi langsung via Dashboard)
EPRESENSI_USERNAME=
EPRESENSI_PASSWORD=

# Token Fonnte WhatsApp API (Opsional: Jika menggunakan Gateway Fonnte)
FONNTE_TOKEN=

# Nomor Admin WhatsApp Notifikasi
WA_NUMBER=
